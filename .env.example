# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Test-Mode Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# Key ID must begin with 'rzp_test_' (Leave blank to use built-in deterministic sandbox mock)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Razorpay Webhook Secret (from Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://<your-tunnel-url>.ngrok-free.app/api/webhooks/razorpay
# Subscribed Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_payment_tracking

# LLM Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# App Server Configuration
PORT=4000
NODE_ENV=development
